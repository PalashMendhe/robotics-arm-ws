# syntax=docker/dockerfile:1
# Phase 3 §3.2 item 1 — COOL containerization for ARM64 (AWS Graviton).
# Multi-stage: builder compiles OpenCV 5 + Arm KleidiCV on linux/arm64;
# runtime keeps only /opt/cool + the cloud inspection service.
# Build on any host via:
#   docker buildx build --platform linux/arm64 -f Dockerfile.cool .
ARG OPENCV_VERSION=5.0.0

FROM --platform=linux/arm64 ubuntu:24.04 AS builder
ARG OPENCV_VERSION
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake git pkg-config \
    python3 python3-dev python3-pip python3-numpy \
    libjpeg-dev libpng-dev libtiff-dev \
    libavcodec-dev libavformat-dev libswscale-dev \
    libtbb-dev libopenblas-dev liblapack-dev gfortran \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Arm KleidiCV — SIMD micro-kernels OpenCV 5 dispatches on Graviton3/4.
RUN git clone --depth 1 https://github.com/arm/KleidiCV.git /opt/KleidiCV

RUN git clone --depth 1 --branch ${OPENCV_VERSION} \
    https://github.com/opencv/opencv.git /opt/opencv && \
    git clone --depth 1 --branch ${OPENCV_VERSION} \
    https://github.com/opencv/opencv_contrib.git /opt/opencv_contrib

RUN cmake -S /opt/opencv -B /opt/opencv/build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/opt/cool \
    -DWITH_KLEIDICV=ON \
    -DKLEIDICV_ROOT=/opt/KleidiCV \
    -DOPENCV_EXTRA_MODULES_PATH=/opt/opencv_contrib/modules \
    -DBUILD_opencv_python3=ON \
    -DPYTHON3_EXECUTABLE=/usr/bin/python3 \
    -DBUILD_TESTS=OFF -DBUILD_PERF_TESTS=OFF \
    -DBUILD_EXAMPLES=OFF -DBUILD_DOCS=OFF \
    -DWITH_TBB=ON -DWITH_OPENMP=ON -DWITH_IPP=OFF \
    -DCPU_BASELINE=NEON -DCPU_DISPATCH=NEON,NEON_DOTPROD,NEON_FP16 && \
    cmake --build /opt/opencv/build -j"$(nproc)" && \
    cmake --install /opt/opencv/build

FROM --platform=linux/arm64 ubuntu:24.04 AS runtime
ENV DEBIAN_FRONTEND=noninteractive \
    LD_LIBRARY_PATH=/opt/cool/lib \
    PYTHONPATH=/opt/cool/lib/python3.12/site-packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-numpy \
    libjpeg-turbo8 libpng16-16 libtiff6 libtbb12 libopenblas0 \
    libavcodec60 libavformat60 libswscale7 \
    && rm -rf /var/lib/apt/lists/* && pip install --break-system-packages \
    fastapi "uvicorn[standard]" boto3 python-multipart
COPY --from=builder /opt/cool /opt/cool
WORKDIR /srv
COPY src/robotic_4dof_arm/scripts/defect_inspector.py \
     src/robotic_4dof_arm/scripts/scene_config.py ./
COPY src/arm_moveit_config/config/robot_params.yaml ./robot_params.yaml
COPY cloud/ ./cloud/
EXPOSE 8000
CMD ["uvicorn", "cloud.cool_service:app", "--host", "0.0.0.0", "--port", "8000"]
