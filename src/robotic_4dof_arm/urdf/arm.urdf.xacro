<?xml version="1.0"?>
<robot name="arm" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- =================================================================== -->
  <!-- ActiveInspect-5 cell wrapper around the OFFICIAL UR5e model.        -->
  <!-- Phase 0 baseline (phased_implementation.md §0.2): the hand-rolled   -->
  <!-- UR5 replica is gone — the arm comes from ur_description with        -->
  <!-- ur_type:=ur5e (default).  This file adds what the cell needs on top -->
  <!-- of the vendor macro: 'world' root link (keeps camera_params.yaml    -->
  <!-- world_offset logic), the custom parallel-jaw gripper FIXED to the   -->
  <!-- flange via an ISO 9409-1-50-4-M6 adapter (0.055 m; tool roll =     -->
  <!-- wrist_3_joint), the eye-in-hand D415 RGB-D camera, and the          -->
  <!-- gz_ros2_control wiring (pattern from ur_simulation_gz).  The Gazebo -->
  <!-- model name stays 'arm' so bridge topics are unchanged.              -->
  <!-- =================================================================== -->

  <xacro:arg name="name" default="arm"/>
  <!-- possible 'ur_type' values: ur3, ur3e, ur5, ur5e, ur7e, ur10, ur10e,
       ur12e, ur16e, ur8long, ur15, ur18, ur20, ur30 -->
  <xacro:arg name="ur_type" default="ur5e"/>
  <xacro:arg name="tf_prefix" default=""/>
  <xacro:arg name="joint_limit_params" default="$(find ur_description)/config/$(arg ur_type)/joint_limits.yaml"/>
  <xacro:arg name="kinematics_params" default="$(find ur_description)/config/$(arg ur_type)/default_kinematics.yaml"/>
  <xacro:arg name="physical_params" default="$(find ur_description)/config/$(arg ur_type)/physical_parameters.yaml"/>
  <xacro:arg name="visual_params" default="$(find ur_description)/config/$(arg ur_type)/visual_parameters.yaml"/>

  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>
  <xacro:include filename="$(find ur_description)/urdf/inc/ur_joint_control.xacro"/>

  <!-- ==================== INERTIA MACROS (gripper parts) ============== -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia
        ixx="${(1/12)*m*(y*y+z*z)}"
        ixy="0" ixz="0"
        iyy="${(1/12)*m*(x*x+z*z)}"
        iyz="0"
        izz="${(1/12)*m*(x*x+y*y)}"/>
    </inertial>
  </xacro:macro>

  <!-- ==================== UR5e ARM (official model) =================== -->
  <link name="world"/>
  <xacro:ur_robot
    name="$(arg name)"
    tf_prefix="$(arg tf_prefix)"
    parent="world"
    joint_limits_parameters_file="$(arg joint_limit_params)"
    kinematics_parameters_file="$(arg kinematics_params)"
    physical_parameters_file="$(arg physical_params)"
    visual_parameters_file="$(arg visual_params)"
    force_abs_paths="false">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:ur_robot>

  <!-- ==================== GRIPPER BASE (tool flange) ================== -->
  <!-- Geometry unchanged; now FIXED to the vendor 'flange' link through
       the 0.055 m ISO 9409-1-50-4-M6 adapter joint below.  Tool roll is
       wrist_3_joint — the old revolute gripper_baseTOwrist_joint and
       gripper_base_joint are gone (phased_implementation.md §0.2). -->
  <link name="gripper_base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.008 0.04 0.04"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.008 0.04 0.04"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="0.2" x="0.008" y="0.04" z="0.04"/>
  </link>
  <joint name="gripper_mount_joint" type="fixed">
    <parent link="flange"/>
    <child link="gripper_base_link"/>
    <!-- ISO 9409-1-50-4-M6 adapter plate: 55 mm below the flange face. -->
    <origin xyz="0 0 0.055" rpy="0 0 0"/>
  </joint>

  <!-- ==================== PRONGS ===================================== -->
  <link name="right_prong_link">
    <visual>
      <origin xyz="0 0 0.018" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.005 0.1"/>
      </geometry>
      <material name="pale_blue">
        <color rgba="0.6 0.8 1.0 1"/>
      </material>
    </visual>
    <collision name="right_prong_link_collision">
      <origin xyz="0 0 0.018" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.005 0.1"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="0.05" x="0.02" y="0.015" z="0.1"/>
  </link>
  <joint name="right_prong_joint" type="prismatic">
    <parent link="gripper_base_link"/>
    <child link="right_prong_link"/>
    <origin xyz="0 0.02 0.018" rpy="0 0 0"/>
    <limit lower="-0.08" upper="0.08" effort="10" velocity="1.0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <link name="left_prong_link">
    <visual>
      <origin xyz="0 0 0.018" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.005 0.1"/>
      </geometry>
      <material name="pale_blue">
        <color rgba="0.6 0.8 1.0 1"/>
      </material>
    </visual>
    <collision name="left_prong_link_collision">
      <origin xyz="0 0 0.018" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.005 0.1"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="0.05" x="0.02" y="0.015" z="0.1"/>
  </link>
  <joint name="left_prong_joint" type="prismatic">
    <parent link="gripper_base_link"/>
    <child link="left_prong_link"/>
    <origin xyz="0 -0.02 0.018" rpy="0 0 0"/>
    <limit lower="-0.08" upper="0.08" effort="10" velocity="1.0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ==================== GRIPPER TCP (tool center point) ============= -->
  <link name="gripper_tcp"/>
  <joint name="gripper_base_to_tcp" type="fixed">
    <parent link="gripper_base_link"/>
    <child link="gripper_tcp"/>
    <origin xyz="0.0 0.0 0.075" rpy="0.0 0.0 0.0"/>
  </joint>

  <!-- ==================== WRIST CAMERA (eye-in-hand) ================== -->
  <!-- Mounted on the gripper body, 50 mm to +X (perpendicular to the jaw
       travel axis Y, so the prongs can never hit it) and 50 mm above the
       jaw mid-plane.  Optical axis = gripper_base_link +Z = straight down
       the tool axis: at every IK-solved pose this is a nadir view by
       construction (implementation.md §3.4). -->
  <link name="d415_wrist_link">
    <visual>
      <origin xyz="-0.045 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.09 0.025 0.025"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="-0.045 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.09 0.025 0.025"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="0.08" x="0.09" y="0.025" z="0.025"/>
  </link>
  <joint name="wrist_camera_joint" type="fixed">
    <parent link="gripper_base_link"/>
    <child link="d415_wrist_link"/>
    <!-- rpy (0, -90°, 0): camera +X (view direction) = gripper_base +Z;
         camera +Y = gripper_base +Y; camera +Z = gripper_base -X. -->
    <origin xyz="0.05 0.0 -0.05" rpy="0 -1.5707 0"/>
  </joint>

  <!-- ==================== GAZEBO FRICTION & CONTACT PROPERTIES ======== -->
  <gazebo reference="right_prong_link">
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <sensor name="right_prong_contact" type="contact">
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <contact>
        <collision>right_prong_link_collision</collision>
      </contact>
      <topic>right_prong_contact</topic>
    </sensor>
  </gazebo>
  <gazebo reference="left_prong_link">
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <sensor name="left_prong_contact" type="contact">
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <contact>
        <collision>left_prong_link_collision</collision>
      </contact>
      <topic>left_prong_contact</topic>
    </sensor>
  </gazebo>

  <gazebo reference="d415_wrist_link">
    <!-- Eye-in-hand RGBD camera.  Topic prefix d415_wrist -> gz topics
         /d415_wrist/{image,depth_image,camera_info,points}; vision_sim.launch.py
         bridges them to ROS unchanged.  Near clip 0.30 m conveniently culls the
         gripper hardware itself from every frame (jaws are <= 0.12 m from the
         lens). -->
    <sensor name="d415_wrist" type="rgbd_camera">
      <pose>0 0 0 0 0 0</pose>
      <camera>
        <!-- D415 horizontal FOV: 69.4 deg = 1.2112 rad -->
        <horizontal_fov>1.2112</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>RGB_INT8</format>
        </image>
        <clip>
          <near>0.3</near>
          <far>10.0</far>
        </clip>
        <depth_camera>
          <clip>
            <near>0.3</near>
            <far>5.0</far>
          </clip>
        </depth_camera>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>false</visualize>
      <topic>d415_wrist</topic>
      <gz_frame_id>d415_wrist_link</gz_frame_id>
    </sensor>
  </gazebo>

  <!-- ==================== ros2_control (Gazebo Sim) ================== -->
  <ros2_control name="arm_system" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <!-- The six UR5e joints with vendor command/state interfaces.  The
         initial positions are the cell's UR5e standby/home pose
         (robot_params.yaml joints.home_position) so the arm spawns
         standing instead of collapsing before the HOME publish. -->
    <xacro:ur_joint_control_description
      tf_prefix="$(arg tf_prefix)"
      initial_positions="${dict(
        shoulder_pan_joint=0.0,
        shoulder_lift_joint=-1.5707963267948966,
        elbow_joint=0.0,
        wrist_1_joint=-1.5707963267948966,
        wrist_2_joint=0.0,
        wrist_3_joint=0.0)}"/>
    <joint name="right_prong_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.06</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="left_prong_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">-0.06</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- gz_ros2_control plugin.  NOTE: the literal $(find robotic_4dof_arm)
       inside <parameters> is NOT expanded by xacro.process_file() at
       launch-generation time — vision_sim.launch.py replaces it with the
       absolute share-dir path before any Node consumes robot_description
       (that replacement is what keeps the controllers loading). -->
  <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find robotic_4dof_arm)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>
</robot>



